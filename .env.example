# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://reviewmind:reviewmind@localhost:5432/reviewmind

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Frontend → Backend (used by frontend/next.config.ts rewrites) ---
# In production this should be the deployed backend's URL (e.g. Railway).
BACKEND_URL=http://localhost:8000

# --- GitHub ---
GITHUB_TOKEN=your_fine_grained_pat_here

# --- Anthropic (Phase 7) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- Auth (Phase 7) ---
# Generate JWT_SECRET with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-password-here

# --- Supabase (Phase 8) ---
# Backend (server-side, keep secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend (frontend/next.config.ts loads vars from this same root .env —
# do not create a separate frontend/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
